# DMARC Control 2.2.1 release deployment
# Copy this file to .env next to docker-compose.release.yml. Do not commit .env.

# Required: choose a unique, strong bootstrap password for this installation.
OPENSEARCH_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Query Insights is intentionally disabled; it is not needed by DMARC Control.
OPENSEARCH_QUERY_INSIGHTS_ENABLED=false

# Grafana is not part of docker-compose.release.yml.
COMPOSE_PROFILES=
GRAFANA_ADMIN_PASSWORD=

# Forensic/RUF retention is disabled unless explicitly approved.
PARSEDMARC_SAVE_FAILURE=False
PARSER_OPENSEARCH_MONTHLY_INDEXES=True

# DNS refresh cadence for registered domains; minimum is 300 seconds.
DOMAIN_DNS_REFRESH_SECONDS=3600

# Integrated backup worker. The schedule is UTC.
DMARC_BACKUP_ROOT=./backups
DMARC_BACKUP_SCHEDULE="0 2 * * *"
DMARC_BACKUP_RETENTION_DAYS=30
DMARC_BACKUP_POLL_SECONDS=30
DMARC_BACKUP_PARSER_PAUSE_TIMEOUT=60
DMARC_CONTROL_RELEASE=2.2.1

# The GHCR pull token is deliberately not stored here. Authenticate once with:
# printf '%s' "$GHCR_PULL_TOKEN" | docker login ghcr.io -u cybernoodles --password-stdin
