OPENSEARCH_ADMIN_PASSWORD=DeinOpenSearchPasswort
# Query Insights wird vom Produkt nicht verwendet und erzeugt sonst täglich
# top_queries-Indizes. Nur für eine bewusste Diagnose temporär aktivieren.
OPENSEARCH_QUERY_INSIGHTS_ENABLED=false
# Standardinstallation ohne Grafana. Für die optionale Übergangsvariante:
# COMPOSE_PROFILES=grafana setzen und ein starkes Grafana-Passwort eintragen.
COMPOSE_PROFILES=
GRAFANA_ADMIN_PASSWORD=
# Forensic-/RUF-Speicherung nur nach dokumentierter Freigabe aktivieren.
PARSEDMARC_SAVE_FAILURE=False
# Monatsindizes sind für normale DMARC-Datenmengen der Produktstandard.
PARSER_OPENSEARCH_MONTHLY_INDEXES=True
