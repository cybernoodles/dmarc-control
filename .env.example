OPENSEARCH_ADMIN_PASSWORD=DeinOpenSearchPasswort
# Query Insights wird vom Produkt nicht verwendet und erzeugt sonst täglich
# top_queries-Indizes. Nur für eine bewusste Diagnose temporär aktivieren.
OPENSEARCH_QUERY_INSIGHTS_ENABLED=false
# Standardinstallation ohne Grafana. Für die optionale Übergangsvariante:
# COMPOSE_PROFILES=grafana setzen und ein starkes Grafana-Passwort eintragen.
COMPOSE_PROFILES=
GRAFANA_ADMIN_PASSWORD=
# Forensic-/RUF-Speicherung nur nach dokumentierter Freigabe aktivieren.
PARSEDMARC_SAVE_FAILURE=False
# Monatsindizes sind für normale DMARC-Datenmengen der Produktstandard.
PARSER_OPENSEARCH_MONTHLY_INDEXES=True

# Aktuelle MX-/SPF-/DKIM-Hinweise für registrierte Domains werden im
# Hintergrund erneuert. Dies ist das maximale Intervall; kürzere DNS-TTLs
# werden früher berücksichtigt. Mindestwert: 300 Sekunden.
DOMAIN_DNS_REFRESH_SECONDS=3600

# Die Backup-Strategie selbst wird verpflichtend im Web-Setup gewählt.
# Diese Werte steuern nur den integrierten Dienst, wenn "Integrierte Dumps"
# ausgewählt wurde. Zeitplan ist UTC und aktuell als täglicher Cron-Ausdruck.
DMARC_BACKUP_ROOT=./backups
DMARC_BACKUP_SCHEDULE="0 2 * * *"
DMARC_BACKUP_RETENTION_DAYS=30
DMARC_BACKUP_POLL_SECONDS=30
DMARC_BACKUP_PARSER_PAUSE_TIMEOUT=60
DMARC_CONTROL_RELEASE=unknown
